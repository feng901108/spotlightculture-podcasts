{
  "name": "apple-podcasts-server",
  "version": "1.0.0",
  "description": "Apple Podcasts 播客服务器 - 基于 EdgeOne Pages",
  "build": {
    "command": "npm run build",
    "output": "dist"
  },
  "functions": {
    "directory": "functions",
    "runtime": "nodejs18",
    "routes": [
      {
        "path": "/api/auth/login",
        "function": "api/auth.js"
      },
      {
        "path": "/api/auth/callback",
        "function": "api/auth.js"
      },
      {
        "path": "/api/auth/me",
        "function": "api/auth.js"
      },
      {
        "path": "/api/auth/logout",
        "function": "api/auth.js"
      },
      {
        "path": "/api/auth/admin-login",
        "function": "api/auth.js"
      },
      {
        "path": "/api/setup/status",
        "function": "api/setup.js"
      },
      {
        "path": "/api/setup/init",
        "function": "api/setup.js"
      },
      {
        "path": "/api/config",
        "function": "api/config.js"
      },
      {
        "path": "/api/podcast",
        "function": "api/podcast.js"
      },
      {
        "path": "/api/episodes",
        "function": "api/episodes.js"
      },
      {
        "path": "/api/episodes/:id",
        "function": "api/episodes.js"
      },
      {
        "path": "/api/upload/presign",
        "function": "api/upload.js"
      },
      {
        "path": "/feed.xml",
        "function": "feed.xml.js"
      }
    ]
  },
  "kv": {
    "bindings": [
      {
        "name": "PODCAST_KV",
        "type": "kv_namespace"
      }
    ]
  },
  "env": {
    "FEISHU_APP_ID": {
      "description": "飞书应用 App ID"
    },
    "FEISHU_APP_SECRET": {
      "description": "飞书应用 App Secret"
    },
    "FEISHU_REDIRECT_URI": {
      "description": "飞书 OAuth 回调地址"
    },
    "COS_SECRET_ID": {
      "description": "腾讯云 COS SecretId"
    },
    "COS_SECRET_KEY": {
      "description": "腾讯云 COS SecretKey"
    },
    "COS_BUCKET": {
      "description": "COS 存储桶名称"
    },
    "COS_REGION": {
      "description": "COS 存储桶地域"
    },
    "COS_BASE_URL": {
      "description": "COS 访问基础 URL（可选）"
    }
  }
}
